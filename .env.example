# Copy to .env and fill in real values. .env is git-ignored — never commit secrets.
# Consolidated from underpath_flood_dashboard (none), flood3's .env.example, and
# SAM's notification.env.example. See docs/integration_plan.md sections 3-3 and 5-7
# for the SOLAPI_SENDER vs. SMS_FROM naming fix made during the merge.
#
# ⚠️ 값 뒤에 같은 줄로 주석을 달지 마세요 — python-dotenv는 줄 끝 주석을
#   잘라내지 않고 값의 일부로 그대로 읽습니다(2026-09-11, 신규 설치 실기
#   테스트로 발견 — ALERT_RECIPIENTS가 그렇게 돼 있어 flood/traffic 서비스가
#   기동 즉시 "잘못된 전화번호 형식" 오류로 죽었습니다). 설명은 반드시
#   그 값의 윗줄에 별도의 '#' 줄로 적으세요.

# --- VLM interpretation (Gemini) — traffic_weather agents, crowd (Phase 5) ---
GEMINI_API_KEY=
GOOGLE_API_KEY=

# --- External sensor data — rainfall / river / CCTV discovery (traffic_weather) ---
# Korea Meteorological Administration ultra-short-term nowcast
KMA_SERVICE_KEY=
# Korea flood control office river water level
HRFCO_API_KEY=
# national ITS road CCTV OpenAPI (scripts/its_cctv.py)
ITS_API_KEY=
# Busan CCTV installation registry (scripts/busan_cctv.py)
BUSAN_API_KEY=

# --- Crowd training data — TfL(London) JamCams (docs/202608251212) ---
# Sign up at https://api-portal.tfl.gov.uk/signup, subscribe to the
# "500 Requests per min" product, copy the Primary key from Profile.
# NOT for live Busan monitoring — London-only, images refresh every 5-10 min.
# Used only for crowd-detection training-data diversity, not production sites.
TFL_APP_KEY=

# --- SOLAPI SMS / Kakao Alimtalk notification (common/notifier.py) ---
# Shared by every domain (flood / traffic_weather / crowd) — see Phase 4.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# pre-registered sender phone number, digits only
# (NOT "SMS_FROM" — flood3's original name was never actually read by any
# code; standardized here)
SOLAPI_SENDER=
# comma-separated recipient phone numbers, digits only
ALERT_RECIPIENTS=
# required for Kakao Alimtalk
SOLAPI_KAKAO_PF_ID=
# required for Kakao Alimtalk
SOLAPI_KAKAO_TEMPLATE_ID=
# true during setup/testing; false for live sending
NOTIFICATION_DRY_RUN=true
# per-event-per-channel duplicate-send suppression window (seconds)
NOTIFICATION_COOLDOWN_SECONDS=30

# --- Control-center webhook (optional, not yet implemented) ---
WEBHOOK_URL=
WEBHOOK_TOKEN=

# --- Crowd domain (SAM3, Phase 5 — optional, needs local GPU) ---
# defaults to <repo>/SAM3 if unset; sam3.pt must live here
# SAM3_ROOT=
