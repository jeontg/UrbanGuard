# Copy to .env and fill in real values. .env is git-ignored — never commit secrets.
# Consolidated from underpath_flood_dashboard (none), flood3's .env.example, and
# SAM's notification.env.example. See docs/integration_plan.md sections 3-3 and 5-7
# for the SOLAPI_SENDER vs. SMS_FROM naming fix made during the merge.

# --- VLM interpretation (Gemini) — traffic_weather agents, crowd (Phase 5) ---
GEMINI_API_KEY=
GOOGLE_API_KEY=

# --- External sensor data — rainfall / river / CCTV discovery (traffic_weather) ---
KMA_SERVICE_KEY=          # Korea Meteorological Administration ultra-short-term nowcast
HRFCO_API_KEY=            # Korea flood control office river water level
ITS_API_KEY=              # national ITS road CCTV OpenAPI (scripts/its_cctv.py)
BUSAN_API_KEY=            # Busan CCTV installation registry (scripts/busan_cctv.py)

# --- Crowd training data — TfL(London) JamCams (docs/202608251212) ---
# Sign up at https://api-portal.tfl.gov.uk/signup, subscribe to the
# "500 Requests per min" product, copy the Primary key from Profile.
# NOT for live Busan monitoring — London-only, images refresh every 5-10 min.
# Used only for crowd-detection training-data diversity, not production sites.
TFL_APP_KEY=

# --- SOLAPI SMS / Kakao Alimtalk notification (common/notifier.py) ---
# Shared by every domain (flood / traffic_weather / crowd) — see Phase 4.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=            # pre-registered sender phone number, digits only
                          # (NOT "SMS_FROM" — flood3's original name was never
                          # actually read by any code; standardized here)
ALERT_RECIPIENTS=         # comma-separated recipient phone numbers, digits only
SOLAPI_KAKAO_PF_ID=       # required for Kakao Alimtalk
SOLAPI_KAKAO_TEMPLATE_ID= # required for Kakao Alimtalk
NOTIFICATION_DRY_RUN=true         # true during setup/testing; false for live sending
NOTIFICATION_COOLDOWN_SECONDS=30  # per-event-per-channel duplicate-send suppression window

# --- Control-center webhook (optional, not yet implemented) ---
WEBHOOK_URL=
WEBHOOK_TOKEN=

# --- Crowd domain (SAM3, Phase 5 — optional, needs local GPU) ---
# SAM3_ROOT=              # defaults to <repo>/SAM3 if unset; sam3.pt must live here
