__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# secrets
.env

# 로컬 개발용 PostgreSQL 바이너리·데이터 디렉터리 (docs/ui_design_spec.md 7절).
# 배포 환경의 DB는 별도이며, 이 폴더는 개발 PC에서만 쓰는 임시 인스턴스다.
.tools/

# model weights (large binaries — see docs/integration_plan.md section 5-7 /
# section 8 for how these are provisioned outside git; README documents how
# to obtain them). Small enough test/demo media (data/samples/, data/cases/)
# ARE committed -- only these two extensions and the generated-output
# directories below are excluded.
*.pt
*.pth

# generated at runtime, not shipped fixtures
data/reports/
data/runs/
data/recordings/
data/raw_archive/
# 기관이 화면(S-85)에서 올린 로고. 배포 산출물이 아니라 운영 데이터다 —
# 커밋하면 지자체마다 다른 로고가 코드에 섞인다.
data/branding/
# 화면(S-80)에서 올린 분석용 동영상. 운영 데이터이지 배포 산출물이 아니다.
data/videos/

# externally-downloaded training datasets (docs/road_surface_management_plan.md
# 2-1절) -- not committed, same reasoning as *.pt model weights above: large
# binaries with their own external license (e.g. ODbL) that shouldn't be
# re-hosted in this repo's git history.
data/datasets/

.pytest_cache/
.mypy_cache/

# Claude Code session runtime state (not project config)
.claude/scheduled_tasks.lock

# 2026-09-10, GitHub 반출 준비 중 추가 — 실제 운영 데이터·대용량 산출물이라
# 커밋 대상이 아님(위 data/* 예외들과 같은 이유).
# ⚠️ 주의: gitignore는 줄 첫 글자가 #일 때만 주석이다 — 패턴 뒤에 붙이면
# 그 줄 전체(공백·# 포함)가 문자 그대로의 패턴이 돼 아무것도 안 걸러진다
# (2026-09-10 실제로 이 실수로 data/evidence/ 등이 안 걸러진 것을 발견·수정).
# data/evidence/ — 실제 CCTV 증거영상(얼굴·번호판 미마스킹 가능) — 개인정보
data/evidence/
# data/logs/ — 운영 로그(290MB, 소스코드 아님)
data/logs/
# data/training_runs/ — 학습 체크포인트·로그(365MB, *.pt 제외 규칙과 같은 이유)
data/training_runs/
# data/model_probe/ — 모델 성능 확인용 캐시 이미지(운영 중 생성)
data/model_probe/
# data/config/ — 배포별 런타임 상태(perf.json 등) — 배포마다 달라짐
data/config/
# configs/_backup/ — 설정 백업 스냅샷
configs/_backup/

# ONNX/OpenVINO 변환 모델 등 대용량 바이너리(*.pt/*.pth 규칙과 같은 이유,
# 위 21-22행에서 확장자만 막던 것을 디렉터리째 제외로 정리)
models/
